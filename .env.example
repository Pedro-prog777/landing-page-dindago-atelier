# ============================================================================
# FRONTEND — copie para .env e ajuste
# ============================================================================
# Endereço da API. Em desenvolvimento deixe vazio: o Vite faz proxy de /api.
VITE_API_URL=

# Qual cliente esta instalação serve (o slug cadastrado no banco).
# Trocar este valor publica a landing page de outro cliente.
VITE_CLIENT_SLUG=dindago-atelier

# ============================================================================
# BACKEND — copie backend/.env.example para backend/.env
# ============================================================================
# As variáveis do backend ficam em backend/.env.example
