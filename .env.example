# ============================================================================
# VARIÁVEIS DE AMBIENTE — DINDAGÓ ATELIER
# ----------------------------------------------------------------------------
# Copie este arquivo para .env e preencha os valores locais:
#
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# O arquivo .env NUNCA vai para o GitHub — ele está no .gitignore.
# Este .env.example, sim: ele serve de modelo e não contém segredos.
#
# No Vite, apenas variáveis com o prefixo VITE_ chegam ao navegador.
# ATENÇÃO: tudo que tem prefixo VITE_ fica visível no código do site.
# Nunca coloque senha, chave privada ou token secreto aqui.
# ============================================================================

# Endereço do serviço que recebe o formulário de contato (Formspree, EmailJS,
# n8n, etc.). Enquanto estiver vazio, o formulário abre o WhatsApp/e-mail.
VITE_FORM_ENDPOINT=

# Medição de audiência (opcional). Ex.: G-XXXXXXXXXX
VITE_ANALYTICS_ID=

# URL pública do site, usada em metatags de compartilhamento.
# Ex.: https://dindagoatelier.com.br
VITE_SITE_URL=
