# PostgreSQL padrão. Crie um banco chamado dindago e ajuste a senha e a porta
# conforme a sua instalação. Codifique caracteres especiais da senha como URL.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/dindago?schema=public"

# Para desenvolvimento local sem servidor, SQLite continua disponível:
# DATABASE_URL="file:./dev.db"
