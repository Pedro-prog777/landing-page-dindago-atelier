# ============================================================================
# BACKEND — copie para backend/.env e ajuste
#
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# BANCO — SQLite local (não precisa instalar servidor)
# ----------------------------------------------------------------------------
# Configuração padrão para desenvolvimento. O arquivo dev.db fica local e
# está ignorado pelo Git.
DATABASE_URL="file:./dev.db"
#
# PostgreSQL é opcional. Para usar, substitua DATABASE_URL por uma URL no
# formato postgresql://USUARIO:SENHA@HOST:PORTA/dindago?schema=public e rode
# `npm run db:migrate`. Codifique caracteres especiais da senha como URL.