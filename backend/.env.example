# ============================================================================
# BACKEND — copie para backend/.env e ajuste
#
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# BANCO — PostgreSQL
# ----------------------------------------------------------------------------
# Formato:
#   postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
#
# Atenção ao PORTA: a instalação padrão usa 5432, mas nem sempre. Confira em
# postgresql.conf ("port = ...") se a conexão for recusada.
#
# Se a senha tiver caractere especial (@ : / ?), codifique-a para URL:
#   @ vira %40   :  vira %3A   /  vira %2F   #  vira %23
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/dindago?schema=public"

# ----------------------------------------------------------------------------
# SESSÃO
# ----------------------------------------------------------------------------
# Segredo que assina o cookie de sessão. MÍNIMO 32 CARACTERES.
# Em produção gere um valor aleatório:  openssl rand -base64 48
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32-caracteres"

# ----------------------------------------------------------------------------
# SERVIDOR
# ----------------------------------------------------------------------------
PORT=3333

# Origens liberadas no CORS (separe por vírgula se houver mais de uma)
CORS_ORIGIN="http://localhost:5173"

# development | production
NODE_ENV=development

# ----------------------------------------------------------------------------
# SEED — usado apenas para criar o administrador de desenvolvimento.
# NÃO use estes valores em produção.
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@dindago.local"
SEED_ADMIN_PASSWORD="dindago123"

# ----------------------------------------------------------------------------
# MIGRAÇÃO (opcional) — usado só pelo scripts/exportar-dados.ts, para ler o
# banco SQLite antigo. Pode ficar comentado depois que a migração terminar.
# ----------------------------------------------------------------------------
# SQLITE_URL="file:./dev.db"
