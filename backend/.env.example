# ============================================================================
# BACKEND — copie para backend/.env e ajuste
#
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).
# ============================================================================

# PostgreSQL padrão. Crie um banco chamado dindago e ajuste a senha e a porta
# conforme a sua instalação. Codifique caracteres especiais da senha como URL.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/dindago?schema=public"

# Para desenvolvimento local sem servidor, SQLite continua disponível
# (depois rode `npm run db:push` e `npm run db:seed`):
# DATABASE_URL="file:./dev.db"

# Segredo que assina o cookie de sessão. OBRIGATÓRIO, mínimo 32 caracteres.
# O valor abaixo serve só para desenvolvimento — a API se recusa a iniciar
# com ele em produção. Gere um valor aleatório:  openssl rand -base64 48
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32-caracteres"

# Porta da API
PORT=3333

# Origens liberadas no CORS (separe por vírgula se houver mais de uma)
CORS_ORIGIN="http://localhost:5173"

# development | production
NODE_ENV=development

# Usado apenas pelo seed, para criar o administrador de desenvolvimento.
# NÃO use estes valores em produção.
SEED_ADMIN_EMAIL="admin@dindago.local"
SEED_ADMIN_PASSWORD="dindago123"
